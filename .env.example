# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here

# Spring Boot - Image Hosting
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/image_hosting
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JWT
JWT_SECRET_KEY=your_complex_jwt_secret_key_here

# MinIO Application
MINIO_ACCESSKEY=your_minio_access_key
MINIO_SECRETKEY=your_minio_secret_key

# Mail
MAIL_PASSWORD=your_mail_password_here

# FISCO BCOS
BCOS_PEER_1=127.0.0.1:20200
BCOS_PEER_2=127.0.0.1:20201
